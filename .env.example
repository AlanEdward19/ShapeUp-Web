# HTTP profile (dotnet run --launch-profile http) → http://localhost:5141
# HTTPS profile (dotnet run --launch-profile https) → https://localhost:7020
VITE_API_URL=http://localhost:5141
VITE_PUBLIC_SITE_URL=https://shapeup.app

# Firebase *web* identifiers (not private keys). Restrict by HTTP referrer in the Firebase console.
VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_auth_domain_aqui
VITE_FIREBASE_PROJECT_ID=seu_project_id_aqui
VITE_FIREBASE_STORAGE_BUCKET=seu_storage_bucket_aqui
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id_aqui
VITE_FIREBASE_APP_ID=seu_app_id_aqui
VITE_FIREBASE_MEASUREMENTID=
